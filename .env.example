# ---------------------------------------------------------------------------
# AdRa Dijital — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# SECRET'LER ASLA istemciye gönderilemez; NEXT_PUBLIC_ önekli olmayan
# değişkenler yalnızca sunucuda okunur.
# ---------------------------------------------------------------------------

# Kanonik site adresi (SEO canonical, sitemap, OG metadata için)
NEXT_PUBLIC_SITE_URL=https://adradijital.com

# İletişim e-postası (sitede görüntülenen public adres)
NEXT_PUBLIC_CONTACT_EMAIL=merhaba@adradijital.com

# İletişim formunun mesajlarının iletileceği gelen kutusu (yalnızca sunucu)
CONTACT_TO_EMAIL=merhaba@adradijital.com

# Resend API anahtarı (https://resend.com) — form e-posta gönderimi için.
# Boş bırakılırsa form doğrulama çalışır, e-posta yerine sunucu logu düşer.
RESEND_API_KEY=

# Gönderen adresi (Resend'de doğrulanmış domain olmalı)
CONTACT_FROM_EMAIL="AdRa Dijital <form@adradijital.com>"
